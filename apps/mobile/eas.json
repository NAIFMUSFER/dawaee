{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8080",
        "EXPO_PUBLIC_DEMO": "0"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dawaee-api.onrender.com",
        "EXPO_PUBLIC_DEMO": "0"
      }
    },
    "audit-preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "DAWAEE_AUDIT_BUILD": "1",
        "EXPO_PUBLIC_API_URL": "https://dawaee-audit-preview.onrender.com",
        "EXPO_PUBLIC_DEMO": "0"
      }
    },
    "production": {
      "credentialsSource": "remote",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "image": "sdk-55",
        "node": "22.22.2"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dawaee-api.onrender.com",
        "EXPO_PUBLIC_DEMO": "0"
      }
    },
    "ios-testflight": {
      "extends": "production",
      "distribution": "store",
      "environment": "production",
      "ios": {
        "autoIncrement": false,
        "simulator": false,
        "image": "latest",
        "node": "22.22.2"
      },
      "env": {
        "DAWAEE_AUDIT_BUILD": "0"
      }
    },
    "audit-ios-simulator": {
      "extends": "audit-preview",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {},
    "ios-testflight": {
      "ios": {
        "ascAppId": "6813157983",
        "appleTeamId": "A92SD96D4Q",
        "metadataPath": "./store.config.json"
      }
    }
  }
}
