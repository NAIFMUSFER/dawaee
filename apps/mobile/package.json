{
  "name": "@dawaee/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_PUBLIC_API_URL=http://localhost:8080 expo start",
    "android": "EXPO_PUBLIC_API_URL=http://localhost:8080 expo start --android",
    "ios": "EXPO_PUBLIC_API_URL=http://localhost:8080 expo start --ios",
    "web": "EXPO_PUBLIC_API_URL=http://localhost:8080 expo start --web",
    "export:web": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "expo": "~52.0.46",
    "expo-constants": "~17.0.8",
    "expo-linking": "~7.0.5",
    "expo-localization": "~16.0.1",
    "expo-router": "~4.0.21",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "expo-camera": "~16.0.18",
    "expo-image-picker": "~16.0.6",
    "expo-notifications": "~0.29.14",
    "expo-file-system": "~18.0.12",
    "expo-local-authentication": "~15.0.2",
    "expo-sharing": "~13.0.1",
    "expo-clipboard": "~7.0.1",
    "expo-device": "~7.0.3"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.7.2"
  }
}
