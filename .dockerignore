# How much of the working tree the builder is allowed to see.
#
# The production image now builds the web UI from the exact mobile source in
# this commit, so apps/mobile itself must be in the build context. Large or
# machine-local artefacts below remain excluded; Docker installs dependencies
# from the lockfile inside the image.

# Secrets. First, because this is the one that matters.
.env
.env.*
!.env.example
.npmrc
*.pem
*.key
*.p12

# History and CI metadata: nothing at runtime reads them.
.git
.gitignore
.github

# Installed dependencies. The image runs npm ci from lockfiles; shipping host
# node_modules would also ship whichever architecture the developer used.
node_modules
**/node_modules

# Mobile source is required by the Docker web-build stage. Exclude only local
# build/cache/test output that is not an input to the production web bundle.
apps/mobile/.expo
apps/mobile/dist
apps/mobile/dist-*
apps/mobile/coverage
apps/mobile/test

# Build and test output elsewhere.
dist
coverage
*.tsbuildinfo
playwright-report
test-results

# Local tooling and editor state.
.vscode
.idea
*.swp
.DS_Store
Thumbs.db
tmp
*.log

# Docs are not read at runtime. Keep source code and runtime/config manifests.
docs
*.md
!README.md
!apps/mobile/SCREEN_BRIEF.md
