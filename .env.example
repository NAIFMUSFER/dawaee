# ---------------------------------------------------------------- runtime
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
PUBLIC_APP_URL=https://dawaee.app
CORS_ORIGINS=http://localhost:8081,http://localhost:3000
TRUST_PROXY=true

# --------------------------------------------------------------- database
# The API connects as dawaee_app, which cannot bypass row-level security.
DATABASE_URL=postgres://dawaee_app:devpass@127.0.0.1:5433/dawaee_dev
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ------------------------------------------------------------------ auth
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_at_least_48_characters_of_random_entropy_here
JWT_ISSUER=dawaee
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=60
OTP_TTL_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
# Development only. Startup refuses this in production.
OTP_DEBUG_ECHO=false
# Generate with: openssl rand -hex 16 — IPs are only ever stored hashed.
IP_HASH_SALT=CHANGE_ME

# ------------------------------------------------------------- providers
# Every provider defaults to a recording mock. Set real credentials to go live.

# SMS (OTP + caregiver invitations): mock | twilio | unifonic
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=

# WhatsApp Business Platform (official Cloud API only): mock | meta_cloud
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Push (fans out to APNs + FCM): mock | expo
PUSH_PROVIDER=mock
EXPO_ACCESS_TOKEN=

# OCR: mock | google_vision | azure_document_intelligence
OCR_PROVIDER=mock
GOOGLE_VISION_API_KEY=
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# Object storage: local | s3 | r2   (local is refused in production)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_LOCAL_DIR=./.storage
UPLOAD_MAX_BYTES=15728640

# ---------------------------------------------------------------- worker
WORKER_TICK_SECONDS=60
WORKER_ENABLED=true
