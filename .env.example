# ---------------------------------------------------------------- runtime
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
PUBLIC_APP_URL=https://dawaee.app
CORS_ORIGINS=http://localhost:8081,http://localhost:3000
# Number of trusted proxies in front of the app (Render terminates at one).
# NOT a boolean: a boolean would make Fastify trust the whole X-Forwarded-For
# chain and let any client choose its own rate-limit bucket.
TRUST_PROXY_HOPS=1

# --------------------------------------------------------------- database
# The API connects as dawaee_app, which cannot bypass row-level security.
DATABASE_URL=postgres://dawaee_app:devpass@127.0.0.1:5433/dawaee_dev
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ------------------------------------------------------------------ auth
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_at_least_48_characters_of_random_entropy_here
JWT_ISSUER=dawaee
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=60
OTP_TTL_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
# Development only. Startup refuses this in production.
OTP_DEBUG_ECHO=false
# Generate with: openssl rand -hex 16 — IPs are only ever stored hashed.
IP_HASH_SALT=CHANGE_ME

# ------------------------------------------------------------- providers
# Account email defaults to disabled; push and other development providers use mocks.
# Caregiver invitations use the device Messages composer and explicit user sending.
# Account email: configure a verified sending domain before enabling.
ACCOUNT_EMAIL_PROVIDER=disabled
ACCOUNT_EMAIL_SENDER_VERIFIED=false
ACCOUNT_EMAIL_FROM=
ACCOUNT_EMAIL_BASE_URL=https://dawaee-api.onrender.com
RESEND_API_KEY=

# Push (fans out to APNs + FCM): mock | expo
PUSH_PROVIDER=mock
EXPO_ACCESS_TOKEN=

# OCR: mock | google_vision | azure_document_intelligence
OCR_PROVIDER=mock
GOOGLE_VISION_API_KEY=
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# Object storage: local | s3 | r2   (local is refused in production)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_LOCAL_DIR=./.storage
UPLOAD_MAX_BYTES=15728640

# ---------------------------------------------------------------- worker
WORKER_TICK_SECONDS=60
WORKER_ENABLED=true
